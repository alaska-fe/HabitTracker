<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Отступы -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>

    <!-- Типографика -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeHeadline">22</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- Доступность: интерактивные элементы не меньше 44×44 (ТЗ 7.2) -->
    <x:Double x:Key="TouchTarget">44</x:Double>

    <!-- Контейнеры -->
    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="BannerPadding">12</Thickness>
    <Thickness x:Key="TilePadding">12</Thickness>
    <Thickness x:Key="ButtonPadding">16,10</Thickness>
    <Thickness x:Key="FieldPadding">12,8</Thickness>

</ResourceDictionary>