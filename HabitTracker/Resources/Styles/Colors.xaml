<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Бренд: цвет «Синий» из справочника HabitColors -->
    <Color x:Key="Brand">#2563EB</Color>
    <Color x:Key="OnBrand">#FFFFFF</Color>

    <!-- Поверхности -->
    <Color x:Key="PageBackgroundLight">#F4F6FB</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1E293B</Color>

    <!-- Текст -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <!-- Границы -->
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#334155</Color>

    <!-- Семантика -->
    <Color x:Key="SuccessLight">#16A34A</Color>
    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="WarningLight">#B45309</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>

    <!-- Фоны баннеров и строки состояния -->
    <Color x:Key="ErrorBackgroundLight">#FEE2E2</Color>
    <Color x:Key="ErrorBackgroundDark">#450A0A</Color>
    <Color x:Key="SuccessBackgroundLight">#DCFCE7</Color>
    <Color x:Key="SuccessBackgroundDark">#052E16</Color>
    <Color x:Key="InfoBackgroundLight">#DBEAFE</Color>
    <Color x:Key="InfoBackgroundDark">#172554</Color>

</ResourceDictionary>