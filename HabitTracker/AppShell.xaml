<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:HabitTracker.Pages"
       xmlns:texts="clr-namespace:HabitTracker.Texts"
       x:Class="HabitTracker.AppShell"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="{x:Static texts:Messages.HabitsTitle}"
                      ContentTemplate="{DataTemplate pages:HabitsPage}"
                      Route="habits" />
        <ShellContent Title="{x:Static texts:Messages.StatsTitle}"
                      ContentTemplate="{DataTemplate pages:StatsPage}"
                      Route="stats" />
    </TabBar>

</Shell>