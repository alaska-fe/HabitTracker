<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HabitTracker.ViewModels"
             xmlns:texts="clr-namespace:HabitTracker.Texts"
             x:Class="HabitTracker.Pages.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="{x:Static texts:Messages.StatsTitle}">

    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceM}">

        <Border Grid.Row="0" Style="{StaticResource BannerBorderStyle}" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                <Label Grid.Column="0" Text="{Binding ErrorMessage}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{x:Static texts:Messages.Retry}"
                        Command="{Binding LoadCommand}"
                        SemanticProperties.Description="Повторить загрузку статистики" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading, Mode=TwoWay}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="{StaticResource SpaceS}"
                                         IsVisible="{Binding HasItems}"
                                         Margin="{StaticResource CardSpacing}">

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceS}">
                            <Border Grid.Column="0" Style="{StaticResource TileBorderStyle}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceXS}">
                                    <Label Text="{x:Static texts:Messages.TileTotal}"
                                           Style="{StaticResource SecondaryLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding TotalText}"
                                           Style="{StaticResource TitleLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TileBorderStyle}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceXS}">
                                    <Label Text="{x:Static texts:Messages.TileToday}"
                                           Style="{StaticResource SecondaryLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding TodayText}"
                                           Style="{StaticResource TitleLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TileBorderStyle}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceXS}">
                                    <Label Text="{x:Static texts:Messages.TileGoals}"
                                           Style="{StaticResource SecondaryLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding GoalsText}"
                                           Style="{StaticResource TitleLabelStyle}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="{Binding AverageProgressText}" />
                        <Label Text="{Binding LongestCurrentText}" />
                        <Label Text="{Binding LongestEverText}" />
                        <Label Text="{x:Static texts:Messages.AllHabits}"
                               Style="{StaticResource TitleLabelStyle}" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Grid IsVisible="{Binding ShowEmptyState}"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="{StaticResource SpaceM}"
                          VerticalOptions="Center">
                        <Label Grid.Row="0" Text="📊"
                               FontSize="{StaticResource FontSizeDisplay}" HorizontalOptions="Center" />
                        <Label Grid.Row="1" Text="{x:Static texts:Messages.EmptyStats}"
                               Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center" />
                        <Button Grid.Row="2" Text="{x:Static texts:Messages.GoToHabits}"
                                Command="{Binding AddCommand}" HorizontalOptions="Center"
                                SemanticProperties.Description="Перейти к добавлению привычки" />
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatsRowModel">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource CardSpacing}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="{StaticResource SpaceS}" RowSpacing="{StaticResource SpaceXS}">

                                <Border Grid.Column="0" Grid.Row="0" VerticalOptions="Center"
                                        WidthRequest="{StaticResource IconCircleSize}"
                                        HeightRequest="{StaticResource IconCircleSize}"
                                        StrokeThickness="0" Padding="0"
                                        BackgroundColor="{Binding ColorHex, Converter={StaticResource HexToColor}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="{StaticResource IconCorner}" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Glyph}" FontSize="{StaticResource IconGlyphSize}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label Grid.Column="2" Grid.Row="0" Text="{Binding ProgressText}"
                                       Style="{StaticResource SecondaryLabelStyle}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Grid.Row="0" Text="{Binding PercentText}"
                                       Style="{StaticResource SecondaryLabelStyle}" VerticalOptions="Center" />
                                <Label Grid.Column="4" Grid.Row="0" Text="🏆"
                                       IsVisible="{Binding IsGoalReached}" VerticalOptions="Center"
                                       SemanticProperties.Description="Цель достигнута" />

                                <ProgressBar Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1"
                                             Progress="{Binding Progress}"
                                             ProgressColor="{Binding ColorHex, Converter={StaticResource HexToColor}}"
                                             SemanticProperties.Description="Прогресс до цели" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Spacing="{StaticResource SpaceS}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" />
            <Label Text="{x:Static texts:Messages.Loading}"
                   Style="{StaticResource SecondaryLabelStyle}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>