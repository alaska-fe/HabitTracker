<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>HabitTracker</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>HabitTracker</ApplicationTitle>
    <ApplicationId>com.habittracker.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SkipTests Condition="'$(SkipTests)' == ''">false</SkipTests>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563EB" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HabitTracker.Core\HabitTracker.Core.csproj" />
  </ItemGroup>

  <Target Name="RunCoreTests" BeforeTargets="Build" Condition="'$(SkipTests)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="RunCoreTests: запуск тестов и порога покрытия перед сборкой приложения" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory).."
          Command="dotnet test HabitTracker.Tests/HabitTracker.Tests.csproj --configuration $(Configuration) /p:CollectCoverage=true /p:CoverletOutputFormat=cobertura /p:CoverletOutput=&quot;$(MSBuildThisFileDirectory)../TestResults/coverage/&quot; /p:Include=&quot;[HabitTracker.Core]*&quot; /p:ExcludeByAttribute=ExcludeFromCodeCoverage /p:Threshold=80 /p:ThresholdType=line /p:ThresholdStat=total" />
  </Target>

</Project>
